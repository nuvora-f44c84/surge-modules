#!name=微信小程序 · 广告过滤（无脚本版）
#!desc=0.1.0 测试版。收录常用生活服务小程序（丰巢、顺丰、中通、EMS、美团点餐、收钱吧、星巴克、麦当劳、猫眼、微信充值等）广告过滤规则；剔除全部外部 JS 脚本与整域清空规则，不解密 12306。需 Surge iOS 5.14+、重写、MITM 及已信任证书。
#!version=0.1.0
#!category=去广告
#!homepage=https://github.com/nuvora-f44c84/surge-modules/blob/main/docs/wechat-adblock.md

# 参考可莉微信小程序去广告插件的公开规则裁剪：
# https://github.com/Repcz/Tool/blob/dab2af5b1c4846332fb99cea0586e8ec7a5a2068/Surge/Module/Kelee/WexinMiniPrograms_Remove_ads.sgmodule
# 仅保留纯规则、URL Rewrite、防御式内置 JQ 与带明确路径的 Map Local；
# 剔除 12 个外部远程脚本、整域 Map Local 及与规则无关的 MITM 主机。
# 详情、限制与回退方法：docs/wechat-adblock.md

[Rule]
DOMAIN,wxsnsdy.wxs.qq.com,REJECT,extended-matching
DOMAIN,wxsmsdy.video.qq.com,REJECT,extended-matching
DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT,extended-matching
DOMAIN,ads-shopping.shouqianba.com,REJECT,extended-matching
DOMAIN,ad.maoyan.com,REJECT,extended-matching
DOMAIN,e.jparking.cn,REJECT,extended-matching

[URL Rewrite]
(?i)^https://webapi\.qmai\.cn/web/cmk-center/marketing/canvas/advert-reach _ reject
(?i)^https://creditcardapp\.bankcomm\.com/cnsvPmpaMdbcardWeb/page/getGuidePageAds _ reject
(?i)^https://mbmodule-openapi\.paas\.cmbchina\.com/graphic/v2/module/graphic _ reject
(?i)^https://app\.95504\.net/app/json/page_ad/initPageAd\?ver= _ reject
(?i)^https://minipro\.95504\.net/app/json/ad/(?:getPopAdData|getIndexAdData) _ reject
(?i)^https://flow\.dmall\.com/app/home/pops _ reject
(?i)^https://api\.yonghuivip\.com/api/fp/homepage/pop _ reject
(?i)^https://activity\.yonghuivip\.com/api/(?:app/fp/homepage/pop|/web/shensuan/ad) _ reject
(?i)^https://sauron-report\.yonghuivip\.com/collect _ reject
(?i)^https://ump\.ems\.com\.cn/mailAd$ _ reject
(?i)^https://hdgateway\.zto\.com/(?:getApolloConfig|track|getAdInfo|listJumperShow) _ reject
(?i)^https://fscdn\.zto\.com/fs1 _ reject
(?i)^https://aag\.enmonster\.com/apa/index/advert/skin _ reject
(?i)^https://ad\.xiaotucc\.com/advert _ reject
(?i)^https://api-marketing\.zhinengxiyifang\.cn/api/v2/cloudcode/wechat/bid _ reject
(?i)^https://ccmsupport-sz\.tenpay\.com/cgi-bin/common/ccm_page_element\.cgi _ reject
(?i)^https://api\.pinduoduo\.com/api/ktt_gateway/activity/feeds/personal_home_page/ _ reject
(?i)^https://api\.szbgcx\.cn/account/adv/ _ reject

[Body Rewrite]
http-response-jq (?i)^https://mcsp\.cloudpnr\.com/api/miniapp/popular/T_MINIAPP$ '. as $original | try (if type == "object" then del(.data) else . end) catch $original'
http-response-jq (?i)^https://saas-ad\.cloudpnr\.com/huifuad-base-api/api/tactics/ad$ '. as $original | try (if type == "object" and (.data | type) == "array" then .data |= .[3:] else . end) catch $original'
http-response-jq (?i)^https://rms\.meituan\.com/api/v1/rmsmina/c/queryShopPortalInfo\? '. as $original | try (if type == "object" then delpaths([["data","popUpWindows"]]) else . end) catch $original'
http-response-jq (?i)^https://chong\.qq\.com/tws/wxmobile/GetProduct4App\? '. as $original | try (if type == "object" and (.respInfo | type) == "object" then del(.respInfo.reserveProductList) | if (.respInfo.shortcut | type) == "array" then .respInfo.shortcut |= map(select(type != "object" or (.name != "充流量" and .name != "领话费券"))) else . end else . end) catch $original'
http-response-jq (?i)^https://chong\.qq\.com/tws/wxmobile4app/GetSecondProduct\? '. as $original | try (if type == "object" and (.respInfo | type) == "object" then del(.respInfo.productList) | if (.respInfo.shortcut | type) == "array" then .respInfo.shortcut |= map(select(type != "object" or (.name != "充流量" and .name != "领话费券"))) else . end else . end) catch $original'
http-response-jq (?i)^https://chong\.qq\.com/tws/usernumberinfo/GetUserInfo\? '. as $original | try (if type == "object" then delpaths([["data","request","number","markSeat","servicehallOperList"], ["data","request","number","servicehallOperList"], ["data","request","number","markSeat","servicehallFuncList"], ["data","request","number","servicehallFuncList"]]) else . end) catch $original'

