#!name=Siri 与聚焦搜索（iRingo）
#!desc=0.1.1 测试版。基于官方 NSRingo/Siri v4.2.7 脚本（由本仓库 raw 地址直供，规避 GitHub Releases 504 超时），解锁聚焦搜索（Spotlight）、长按“查询（Look Up）”、视觉智能与维基百科知识卡片，同时默认保持中文 Siri 交互（CountryCode=US, SiriLocale=zh_CN）；移除上游残留的 debug=1 调试开关。需脚本与 MITM 支持。
#!openUrl=http://boxjs.com/#/app/iRingo.Siri
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!homepage=https://github.com/nuvora-f44c84/surge-modules/blob/main/docs/iringo-siri-spotlight.md
#!icon=https://developer.apple.com/assets/elements/icons/siri/siri-128x128_2x.png
#!category= iRingo
#!version=0.1.1
#!arguments=CountryCode:US,SiriLocale:zh_CN,Region:OFF,SiriResponseLanguageVariant:zh_CN,Domains:"web,itunes,app_store,movies,restaurants,maps",Functions:"flightutilities,lookup,mail,messages,news,safari,spotlight,visualintelligence",SafariSmartHistory:true,LogLevel:WARN
#!arguments-desc=CountryCode：Siri 与聚焦搜索目标国家或地区代码，默认 US（可改 SG / TW / HK / JP）；SiriLocale：Siri 交互语言区域，默认 zh_CN（保持中文问答，若改 AUTO 则随地区代码切换）；Region：覆盖与区域相关联的设置，默认 OFF；SiriResponseLanguageVariant：Siri 首选响应语言，默认 zh_CN；Domains：搜索领域列表；Functions：启用的功能列表；SafariSmartHistory：Safari 智能历史记录，默认 true；LogLevel：日志等级，默认 WARN。

# SPDX-License-Identifier: Apache-2.0
# Based on NSRingo/Siri v4.2.7:
# https://github.com/NSRingo/Siri/releases/tag/v4.2.7
# Combines iOS 18+ / macOS 15+ Parsec gRPC-Web endpoints and Spotlight /bag, /card, /flight endpoints.
# Removes upstream's accidental `debug=1` flags on binary-body-mode scripts.
# Defaults SiriLocale and SiriResponseLanguageVariant to zh_CN while CountryCode is US.
# Unmodified v4.2.7 release bundles are hosted in ../scripts/iringo/ to avoid github.com/releases/download 504 timeouts.
# License: ../LICENSES/Apache-2.0.txt
# Installation and scope: ../docs/iringo-siri-spotlight.md

[Script]
🔍 Siri.Search.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/search(\?|$),script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Siri.SiriSearch.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.siri\.v2alpha\.SiriSearch\/SiriSearch,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Safari.SafariSearch.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.safari\.v1alpha\.SafariSearch\/SafariSearch,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Lookup.LookupSearch.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.lookup\.v1alpha\.LookupSearch\/LookupSearch,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Visualsearch.VisualSearch.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.visualsearch\.v2\.VisualSearch\/VisualSearch,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 ResponseFramework.Engagement.EngagementSearch.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.responseframework\.engagement\.v1alpha\.EngagementSearch\/EngagementSearch,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Spotlight.ZkwSuggestService.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/apple\.parsec\.spotlight\.v1alpha\.ZkwSuggestService\/Suggest,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Spotlight.bag.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/bag(\?|$),script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Spotlight.bag.response = type=http-response,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/bag(\?|$),requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-response.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Spotlight.card.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/card(\?|$),script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}
🔍 Spotlight.flight.request = type=http-request,pattern=^https?:\/\/api(-|\.)smoot\.apple\.(com|cn)\/flight(\?|$),script-path=https://raw.githubusercontent.com/nuvora-f44c84/surge-modules/main/scripts/iringo/Siri-request.bundle.js,argument=CountryCode={{{CountryCode}}}&SiriLocale={{{SiriLocale}}}&Region={{{Region}}}&SiriResponseLanguageVariant={{{SiriResponseLanguageVariant}}}&Domains={{{Domains}}}&Functions={{{Functions}}}&SafariSmartHistory={{{SafariSmartHistory}}}&LogLevel={{{LogLevel}}}

[MITM]
hostname = %APPEND% guzzoni.smoot.apple.com, api*.smoot.apple.com, api.smoot.apple.cn
