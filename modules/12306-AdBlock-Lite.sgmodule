#!name=铁路 12306 · 广告过滤
#!desc=0.1.0 测试版。直连放行 ad.12306.cn 并移除 getAdList 响应中的广告素材与倒计时参数；无外部脚本，不解密购票网关 mobile.12306.cn。需 Surge iOS 5.14+、重写、MITM 及已信任证书。
#!version=0.1.0
#!category=去广告
#!homepage=https://github.com/nuvora-f44c84/surge-modules

# 独立实现，参考 RuCu6 / 可莉 12306 模块的公开接口线索：
# https://github.com/Repcz/Tool/blob/dab2af5b1c4846332fb99cea0586e8ec7a5a2068/Surge/Module/Kelee/12306_remove_ads.sgmodule
# 仅处理 ad.12306.cn/ad/ser/getAdList；不解密 mobile.12306.cn，避免介入查票、登录与下单网关。
# 详情、限制与回退方法：docs/12306-adblock.md

[Rule]
# 覆盖公共去广告规则集对 ad.12306.cn 的整域 REJECT，使客户端收到剔除素材后的正常响应而非连接失败。
DOMAIN,ad.12306.cn,DIRECT,extended-matching

[Body Rewrite]
http-response-jq (?i)^https://ad\.12306\.cn/ad/ser/getAdList/?(?:\?.*)?$ '. as $original | try (if type == "object" then del(.materialsList, .advertParam) else . end) catch $original'

[MITM]
hostname = %APPEND% ad.12306.cn
