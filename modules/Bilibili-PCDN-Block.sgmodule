#!name=哔哩哔哩 · PCDN 节点屏蔽
#!desc=0.1.0 测试版。使用 REJECT-NO-DROP 立即拒绝 B 站自营 MCDN、302 第三方调度及派欧云（PPIO）、白山云、臻选云、猫耳 FM 等 77 个 PCDN 域名与关键字，促使播放器毫秒级切换至阿里云/腾讯云等商业主干网备用 CDN（backup_url），缓解千兆宽带下播放卡顿与拖动转圈。纯规则，无需 MITM 或脚本。
#!category=实用工具
#!version=0.1.0

# 原理：B 站播放接口同时下发主地址（常为劣质家宽 PCDN）与商业 CDN 备用地址（backup_url）。
# 必须使用 REJECT-NO-DROP（立即返回连接拒绝）而非 REJECT-DROP（静默丢包等待超时），播放器才会 0 秒切向备用主干 CDN。
# 已去重并剔除与视频流无关的 cm.bilibili.com / data.bilibili.com，专注 PCDN 传输节点。
# 说明与回退：../docs/bilibili-pcdn-block.md

[Rule]
# Bilibili MCDN & 302 PCDN Scheduling
DOMAIN-SUFFIX,mcdn.bilivideo.cn,REJECT-NO-DROP,extended-matching
DOMAIN-SUFFIX,mcdn.bilivideo.com,REJECT-NO-DROP,extended-matching
DOMAIN-SUFFIX,ppio.bilivideo.com,REJECT-NO-DROP,extended-matching
DOMAIN-SUFFIX,kodo.bilivideo.com,REJECT-NO-DROP,extended-matching
DOMAIN-WILDCARD,upos-sz-302*.bilivideo.com,REJECT-NO-DROP,extended-matching
DOMAIN-SUFFIX,szbdyd.com,REJECT-NO-DROP,extended-matching

# Bilibili / Maoer FM Audio PCDN
DOMAIN-SUFFIX,solseed.cn,REJECT-NO-DROP,extended-matching
DOMAIN-SUFFIX,solseedr.cn,REJECT-NO-DROP,extended-matching

